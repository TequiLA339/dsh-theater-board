{
  "name": "dsh-theater-board",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "战区经营看板 DSH 插件：在 DeepSeek Harness 左侧栏打开本机战区看板（看板 / 更新数据 / 历史版本）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "lib/",
    "assets/",
    "backend/",
    "package-lock.json",
    "build-manifest.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  }
}
